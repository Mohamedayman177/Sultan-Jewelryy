APP_NAME="Sultan Jewelry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sultan_jewelry
DB_USERNAME=root
DB_PASSWORD=

# Alternative local setup (no MySQL):
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp wa.me number without + or spaces (used after saving evaluation lead form)
WHATSAPP_NUMBER=966538600000

# MyFatoorah (SendPayment). Use test host + key from dashboard until going live.
# Local: same host as php artisan serve. If MyFatoorah rejects private URLs, use a public tunnel URL here.
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=
MYFATOORAH_TIMEOUT=45
MYFATOORAH_PLACEHOLDER_EMAIL=payments@sultan-jewelry.local
MYFATOORAH_PUBLIC_APP_URL=http://127.0.0.1:8000
# إعادة استعلام GetPaymentStatus بعد الرجوع من الدفع (Pending → Paid)
MYFATOORAH_STATUS_POLL_ATTEMPTS=20
MYFATOORAH_STATUS_POLL_DELAY_MS=500
# بعد الاختبار: php artisan payments:reconcile-myfatoorah (لمزامنة «بانتظار الدفع» مع البوابة عبر رقم الفاتورة)

# Admin dashboard (/admin/login) — change password after first deploy
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@sultan-jewelry.local
ADMIN_PASSWORD=password
